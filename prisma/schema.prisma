datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// 1. NGƯỜI DÙNG & PHÂN QUYỀN (Admin, Giáo viên, Học sinh)
model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String?   @unique
  name               String
  passwordHash       String
  role               String    @default("STUDENT") // ADMIN, TEACHER, STUDENT
  status             String    @default("ACTIVE")  // ACTIVE, LOCKED, INACTIVE
  avatar             String?
  mustChangePassword Boolean   @default(false)
  currentHskLevel    Int       @default(1)
  totalXp            Int       @default(0)
  streakDays         Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Quan hệ
  taughtClasses      Class[]         @relation("TeacherClasses")
  enrolledClasses    ClassStudent[]
  assignments        AssignmentTarget[]
  attempts           Attempt[]
  wrongQuestions     WrongQuestion[]
  vocabProgress      VocabProgress[]
  gameSessions       GameSession[]
  xpLogs             XpLog[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  createdQuestions   Question[]      @relation("TeacherQuestions")
  createdQuizSets    QuizSet[]       @relation("TeacherQuizSets")
  teacherVocabulary TeacherVocabulary[]
  savedTeacherLessons TeacherSavedLesson[]
  teachingMaterials TeachingMaterial[]
}

// 2. LỚP HỌC
model Class {
  id          String   @id @default(cuid())
  name        String   // Ví dụ: HSK 1A, HSK 1B, HSK 2A
  level       Int      @default(1) // 1 đến 9 (HSK 3.0)
  teacherId   String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User           @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  students    ClassStudent[]
  assignments Assignment[]
  lessons     ClassLesson[]
  materials   MaterialClass[]
  schedules   ClassSchedule[]
}

model ClassLesson {
  id               String   @id @default(cuid())
  classId          String
  lessonId         String   // "hsk1-01", "hsk1-b01", etc.
  lessonNumber     Int      // 1 to 15
  titleZh          String
  titleVi          String
  pinyin           String?
  status           String   @default("PUBLISHED") // DRAFT, PUBLISHED
  vocabCount       Int      @default(0)
  grammarCount     Int      @default(0)
  hasDialogue      Boolean  @default(true)
  hasReading       Boolean  @default(true)
  culturalCount    Int      @default(0)
  selectedVocabs   String?  // JSON stringified array of selected vocabularies
  selectedGrammars String?  // JSON stringified array of selected grammars
  selectedDialogue String?  // JSON stringified dialogue
  selectedCultural String?  // JSON stringified cultural items
  teacherNote      String?
  dueDate          String?
  publishedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
  content          Json?

  class            Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, lessonNumber])
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  status    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  joinedAt  DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

// 3. GIÁO TRÌNH, CẤP ĐỘ & BÀI HỌC (Curriculum, Level, Lesson)
model CurriculumContent {
  hskLevel  Int      @id
  lessons   Json
  revision  Int      @default(1)
  isDeleted Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}

model Curriculum {
  id          String   @id @default(cuid())
  title       String   // Giáo trình chuẩn HSK 3.0
  description String?
  createdAt   DateTime @default(now())

  levels      Level[]
}

model Level {
  id           String     @id @default(cuid())
  curriculumId String
  hskLevel     Int        // 1 đến 9
  title        String     // HSK 1 Sơ cấp
  description  String?
  isOpen       Boolean    @default(true)

  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
}

model Lesson {
  id           String   @id @default(cuid())
  levelId      String
  lessonNumber Int      // Bài 4, Bài 5
  title        String   // Bài 4: 家庭 (Gia đình), Bài 5: 购物 (Mua sắm)
  description  String?
  status       String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  level        Level             @relation(fields: [levelId], references: [id], onDelete: Cascade)
  vocabularies Vocabulary[]
  grammarPoints GrammarPoint[]
  listeningItems ListeningItem[]
  readingItems ReadingItem[]
  quizSets     QuizSet[]
}

// 4. NỘI DUNG BÀI HỌC
model Vocabulary {
  id           String   @id @default(cuid())
  lessonId     String
  hanzi        String   // 妈妈
  pinyin       String   // māma
  meaningVi    String   // Mẹ
  meaningEn    String?
  wordType     String?  // Danh từ, Động từ
  audioUrl     String?
  exampleHanzi String?
  examplePinyin String?
  exampleMeaning String?
  createdAt    DateTime @default(now())

  lesson       Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress     VocabProgress[]
}

model GrammarPoint {
  id           String   @id @default(cuid())
  lessonId     String
  title        String   // Ngữ pháp 把字句
  structure    String   // S + 把 + O + V + Thành phần khác
  explanation  String   // Giải thích chi tiết
  examples     String?  // JSON hoặc Text ví dụ
  createdAt    DateTime @default(now())

  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model ListeningItem {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  audioUrl    String
  transcript  String?
  translation String?
  createdAt   DateTime @default(now())

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model ReadingItem {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  content     String
  translation String?
  createdAt   DateTime @default(now())

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// 5. NGÂN HÀNG CÂU HỎI & BỘ ĐỀ (Questions & QuizSets)
model Question {
  id            String   @id @default(cuid())
  type          String   // single_choice, multi_choice, true_false, fill_blank, matching, ordering, listening, pinyin_input, short_answer
  content       String   // Đề bài
  pinyinPrompt  String?
  audioUrl      String?
  imageUrl      String?
  options       String?  // JSON: [{"id": "A", "text": "苹果"}, ...]
  correctAnswer String   // "A" hoặc đáp án text
  explanation   String?  // Lời giải chi tiết
  skill         String   // VOCABULARY, GRAMMAR, LISTENING, READING, WRITING
  difficulty    String   @default("MEDIUM") // EASY, MEDIUM, HARD
  level         Int      @default(1)
  tags          String?  // "Gia đình, Mua sắm"
  teacherId     String?
  createdAt     DateTime @default(now())

  teacher          User?             @relation("TeacherQuestions", fields: [teacherId], references: [id], onDelete: SetNull)
  quizSetQuestions QuizSetQuestion[]
  attemptAnswers   AttemptAnswer[]
  wrongQuestions   WrongQuestion[]
  privateVocabulary TeacherVocabulary?
  editorData Json?
}

model TeacherSavedLesson {
  id String @id @default(cuid())
  teacherId String
  sourceLessonId String
  title String
  kind String @default("SAVED")
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@index([teacherId, updatedAt])
}

model TeacherVocabulary {
  id         String    @id @default(cuid())
  teacherId  String
  hanzi      String
  pinyin     String
  meaning    String
  wordType   String    @default("")
  exampleZh  String    @default("")
  examplePy  String    @default("")
  exampleVi  String    @default("")
  hskLevel   Int       @default(1)
  questionId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  teacher    User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([teacherId, hanzi, pinyin])
}

model TeachingMaterial {
  id          String          @id @default(cuid())
  teacherId   String
  title       String
  description String          @default("")
  fileName    String
  mimeType    String
  byteSize    Int
  content     Bytes
  createdAt   DateTime        @default(now())
  teacher     User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classes     MaterialClass[]

  @@index([teacherId, createdAt])
}

model MaterialClass {
  materialId String
  classId    String
  sharedAt   DateTime         @default(now())
  material   TeachingMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([materialId, classId])
  @@index([classId])
}

model ClassSchedule {
  id         String              @id @default(cuid())
  classId    String
  title      String
  startDate  String
  endDate    String?
  weekdays   Int[]
  startTime  String
  endTime    String
  room       String              @default("")
  meetUrl    String              @default("")
  color String @default("emerald")
  revision   Int                 @default(1)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt
  class      Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  exceptions ScheduleException[]

  @@index([classId])
}

model ScheduleException {
  id           String        @id @default(cuid())
  scheduleId   String
  originalDate String
  date         String
  startTime    String
  endTime      String
  cancelled    Boolean       @default(false)
  note         String        @default("")
  revision     Int           @default(1)
  schedule     ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, originalDate])
}

model QuizSet {
  id          String   @id @default(cuid())
  lessonId    String?
  teacherId   String?
  title       String   // Bộ câu hỏi Bài 5 - 购物
  description String?
  mode        String   @default("EXAM") // PRACTICE, EXAM
  status      String   @default("READY") // DRAFT, READY, ARCHIVED
  hskLevel    Int      @default(1)
  curriculum  String   @default("HSK 3.0")
  totalScore  Int      @default(100)
  createdAt   DateTime @default(now())

  teacher     User?             @relation("TeacherQuizSets", fields: [teacherId], references: [id], onDelete: SetNull)
  lesson      Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions   QuizSetQuestion[]
  assignments Assignment[]
}

model QuizSetQuestion {
  id         String   @id @default(cuid())
  quizSetId  String
  questionId String
  orderIndex Int      @default(1)
  points     Float    @default(10.0)

  quizSet    QuizSet  @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizSetId, questionId])
}

// 6. GIAO BÀI TẬP & LÀM BÀI (Assignments & Attempts)
model Assignment {
  id          String    @id @default(cuid())
  quizSetId   String
  classId     String
  title       String    // Bài 5 · 购物 (Từ vựng)
  openAt      DateTime  @default(now())
  dueAt       DateTime  // Hạn nộp
  durationMin Int       @default(45) // Thời gian làm bài (phút)
  maxAttempts Int       @default(1)
  mode        String    @default("EXAM") // PRACTICE, EXAM
  latePolicy  String    @default("ALLOW") // ALLOW, BLOCK
  scoreRule   String    @default("BEST")  // BEST, LATEST
  status      String    @default("OPEN")  // SCHEDULED, OPEN, CLOSED
  createdAt   DateTime  @default(now())

  quizSet     QuizSet            @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  targets     AssignmentTarget[]
  attempts    Attempt[]
}

model AssignmentTarget {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Attempt {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  score        Float?
  maxScore     Float     @default(100.0)
  status       String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, NEEDS_GRADING, GRADED, EXPIRED
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  durationSec  Int       @default(0)
  teacherNote  String?

  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      AttemptAnswer[]
}

model AttemptAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  userAnswer  String?
  isCorrect   Boolean  @default(false)
  scoreEarned Float    @default(0.0)
  teacherNote String?

  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// 7. CÂU SAI & TIẾN ĐỘ TỪ VỰNG LEITNER
model WrongQuestion {
  id               String   @id @default(cuid())
  studentId        String
  questionId       String
  wrongCount       Int      @default(1)
  consecutiveRight Int      @default(0) // Đúng 3 lần liên tiếp thì gỡ
  lastWrongAt      DateTime @default(now())

  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
}

model VocabProgress {
  id            String   @id @default(cuid())
  studentId     String
  vocabularyId  String
  leitnerBox    Int      @default(1) // 1 đến 5 hộp
  nextReviewAt  DateTime @default(now())
  correctStreak Int      @default(0)
  lastReviewedAt DateTime @default(now())

  student       User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vocabulary    Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([studentId, vocabularyId])
}

// 8. GAME CENTER & XẾP HẠNG
model GameSession {
  id          String   @id @default(cuid())
  studentId   String
  gameType    String   // race, match, build, listen, tf, type
  score       Int      @default(0)
  durationSec Int      @default(0)
  xpEarned    Int      @default(0)
  correct     Int      @default(0)
  wrong       Int      @default(0)
  maxCombo    Int      @default(0)
  playedAt    DateTime @default(now())

  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model GameConfig {
  id        String   @id @default(cuid())
  classId   String   @unique
  race      Boolean  @default(true)
  match     Boolean  @default(true)
  build     Boolean  @default(true)
  listen    Boolean  @default(true)
  tf        Boolean  @default(true)
  type      Boolean  @default(true)
}

// 9. THƯỞNG, XP, THÔNG BÁO & NHẬT KÝ
model XpLog {
  id        String   @id @default(cuid())
  studentId String
  amount    Int
  source    String   // ASSIGNMENT_SUBMIT, GAME_PLAY, DAILY_STREAK, PRACTICE
  reason    String
  createdAt DateTime @default(now())

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, ASSIGNMENT, GRADE, REMINDER
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id                  String @id @default("default")
  atRiskMinScore      Float  @default(6.5) // Điểm TB dưới ngưỡng
  atRiskInactiveDays  Int    @default(7)   // Quá 7 ngày chưa làm bài
  atRiskOwedCount     Int    @default(2)   // Nợ từ 2 bài trở lên
  xpPerQuestion       Int    @default(1)
  xpPerAssignment     Int    @default(10)
}

// 10. TỪ ĐIỂN NGOẠI TUYẾN (CC-CEDICT + Unihan)
enum DictionaryMeaningViStatus {
  MISSING
  GENERATED
  REVIEWED
}

model DictionaryEntry {
  id              Int      @id @default(autoincrement())
  simplified      String
  traditional     String
  pinyinNumbered  String   // Original CC-CEDICT reading, e.g. "xue2 xi2".
  pinyin          String   // Tone-marked reading, e.g. "xué xí".
  pinyinSearch    String   // Lowercase, toneless, no spaces; ü normalized to v.
  definitionsEn   String[] @default([])
  definitionsVi   String[] @default([]) // Vietnamese meanings, separate from Han-Viet readings.
  meaningViSource String?  // Source or generator/model identifier.
  meaningViStatus DictionaryMeaningViStatus @default(MISSING)
  meaningViUpdatedAt DateTime?
  meaningViRevision Int @default(0)
  meaningViSearch String @default("")
  source          String   @default("CC-CEDICT")
  sourceVersion   String?  // Release date/version from the imported file.
  importedAt      DateTime @default(now())

  characters DictionaryEntryCharacter[]

  // Preserve polyphonic entries and different traditional variants.
  // The importer merges definitions only for this exact lexical key.
  @@unique([traditional, simplified, pinyinNumbered], map: "dictionary_entry_lexical_key")
  @@index([simplified], map: "dictionary_entry_simplified_idx")
  @@index([traditional], map: "dictionary_entry_traditional_idx")
  @@index([pinyinSearch], map: "dictionary_entry_pinyin_search_idx")
}

model DictionaryCharacter {
  character     String   @id // One Unicode code point; not limited to BMP.
  hanViet       String?  // Original kVietnamese field, including alternate readings.
  source        String   @default("Unihan")
  sourceVersion String?
  importedAt    DateTime @default(now())

  entries DictionaryEntryCharacter[]
}

model DictionaryEntryCharacter {
  entryId               Int
  position              Int    // Zero-based Unicode code-point position in traditional.
  traditionalCharacter  String
  simplifiedCharacter   String? // Null if the two spellings cannot align by position.

  entry     DictionaryEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  character DictionaryCharacter @relation(fields: [traditionalCharacter], references: [character], onDelete: Restrict)

  // Position preserves repeated characters in a word, e.g. 妈妈.
  @@id([entryId, position])
  @@index([traditionalCharacter], map: "dictionary_entry_character_traditional_idx")
}

model DictionarySentenceTranslation {
  key            String   @id // SHA-256 of direction + normalized source text.
  sourceText     String
  translatedText String
  pinyin         String
  targetLanguage String
  model          String
  createdAt      DateTime @default(now())
}
