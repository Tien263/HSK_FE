# Database connection URLs (Lấy từ Neon.tech hoặc Supabase hoàn toàn miễn phí)
# DATABASE_URL: Dùng chuỗi Pooled Connection (có pgbouncer) cho serverless
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Dùng chuỗi Direct Connection để chạy migration
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Secret (tạo ngẫu nhiên khi làm phần auth)
NEXTAUTH_SECRET="your-super-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"
